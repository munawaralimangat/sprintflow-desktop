{
  "name": "sprintflow-desktop",
  "version": "1.0.0",
  "description": "Minimal, offline Scrum sprint & SDLC workflow desktop application built with Electron.js",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "build": {
    "appId": "com.munawar.sprintflow",
    "productName": "SprintFlow",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!**/*.lnk",
      "!**/*.bat"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SprintFlow"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/munawaralimangat/sprintflow-desktop.git"
  },
  "keywords": [
    "electron",
    "scrum",
    "sprint-tracker",
    "sdlc",
    "kanban",
    "desktop-app",
    "productivity"
  ],
  "author": "Munawar Ali Mangat",
  "license": "MIT",
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^26.15.3"
  }
}
